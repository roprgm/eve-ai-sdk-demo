{
  "name": "eve-ai-sdk-demo",
  "version": "0.0.0",
  "private": true,
  "description": "A durable Eve channel for Vercel AI SDK useChat frontends.",
  "type": "module",
  "scripts": {
    "agent": "eve dev --no-ui --port 3001",
    "build": "vite build app",
    "build:agent": "eve build",
    "check": "biome check .",
    "dev": "concurrently -k -n eve,web \"bun run agent\" \"bun run web\"",
    "format": "biome format --write .",
    "test": "vitest run --dir test",
    "typecheck": "tsc --noEmit",
    "web": "vite app"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": "24.x"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.0",
    "ai": "^7.0.0",
    "eve": "^0.27.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
